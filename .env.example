DATABASE_URL=postgresql://analytics_games:analytics_games@localhost:5432/analytics_games?sslmode=disable
PLATFORM_ADMIN_TOKEN=replace-with-a-long-random-token
OPENROUTER_API_KEY=replace-with-a-server-side-openrouter-key

# Optional local/remote sidecar override. Leave unset to use the bundled CPU
# ONNX runtime in the Next.js server (the production default).
# STYLED_CHESS_INFERENCE_URL=http://127.0.0.1:8765
STYLED_CHESS_DEVICE=cpu

# Optional artifact path overrides for the bundled CPU runtime.
# STYLED_CHESS_ONNX_PATH=public/models/styled-opening.onnx
# STYLED_CHESS_POLICY_VOCAB_PATH=public/models/styled-policy-vocab.json
# STYLED_CHESS_HISTORY_VOCAB_PATH=public/models/styled-history-vocab.json
# STYLED_CHESS_BOOK_PATH=public/models/styled-opening-book.json

# The following variables are used only by the optional Python sidecar launcher.
STYLED_CHESS_ROOT=../ml-anti-stockfish-service
STYLED_CHESS_CHECKPOINT=../ml-anti-stockfish-service/artifacts/pgnmentor-trained.safetensors
STYLED_CHESS_BOOK_RECORDS=../ml-anti-stockfish-service/artifacts/pgnmentor-corpus/train.jsonl
