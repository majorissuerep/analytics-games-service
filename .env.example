DATABASE_URL=postgresql://analytics_games:***@localhost:5432/analytics_games?sslmode=disable
PLATFORM_ADMIN_TOKEN=replace-with-a-long-random-token
OPENROUTER_API_KEY=replace-with-a-server-side-openrouter-key
EVENT_TRACKING_ENABLED=false
EVENT_TRACKING_URL=https://events.theincompetent.app
EVENT_WRITE_KEY=replace-with-a-server-side-site-write-key

# Chess custom models: always required
CHESS_MODEL_ABUSE_SALT=replace-with-a-long-random-salt
CHESS_MODEL_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Chess custom models: optional direct package upload (S3-compatible quarantine storage).
# When unset, direct upload is disabled in the UI and Hugging Face submissions remain available.
MODEL_STORAGE_BUCKET=
MODEL_STORAGE_REGION=
MODEL_STORAGE_ACCESS_KEY_ID=
MODEL_STORAGE_SECRET_ACCESS_KEY=
# MODEL_STORAGE_ENDPOINT=required for MinIO/R2-compatible endpoints; optional for AWS
# MODEL_STORAGE_FORCE_PATH_STYLE=true
