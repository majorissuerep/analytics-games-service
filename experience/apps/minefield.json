{
  "schemaVersion": 1,
  "id": "minefield",
  "vision": "docs/experience/VISION.md",
  "request": "minefield-elite",
  "route": "/games/minefield",
  "preferredWindow": {
    "width": 480,
    "height": 600
  },
  "modeWindows": {
    "intermediate": {
      "width": 720,
      "height": 660
    },
    "expert": {
      "width": 1120,
      "height": 760
    },
    "elite": {
      "width": 720,
      "height": 760
    }
  },
  "scrollOwners": [
    "board pan only when readable grid cannot fit constrained workspace:24px classic,32px Elite",
    "optional bounded proof detail only while its dialog is open"
  ],
  "requiredControls": [
    "Level",
    "New game",
    "reachable reveal/flag/chord cells",
    "Explain move",
    "Elite Layer1/Layer2",
    "Elite Scan echo for revealed unscanned cell",
    "Elite explicit local chord"
  ],
  "states": [
    "ready",
    "generating",
    "active",
    "late99",
    "won",
    "failed",
    "narrowExpert",
    "narrowIntermediate",
    "eliteReady",
    "eliteUnscanned",
    "eliteEcho",
    "eliteCrossProof",
    "eliteWon",
    "generationTimeout"
  ],
  "forbidden": [
    "Cell size control",
    "Flag mode toggle",
    "slogans",
    "beginner scrollbars",
    "micro-overflow"
  ],
  "minimumCellPixels": 24,
  "scrollSelectors": {
    "constrainedBoard": ".minefield-board-scroll[data-scroll-owner=\"minefield-board\"][data-panning=\"true\"]",
    "proofDetail": "[data-scroll-owner=\"minefield-proof\"]"
  },
  "minimumEliteCellPixels": 32
}
