+
+#ifdef __EMSCRIPTEN__
+// Touch and cabinet actions use the same native event handler as physical keys.
+extern "C" EMSCRIPTEN_KEEPALIVE void cabinet_key(int code, int down)
+{
+    SDL_Event event{};
+    event.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    switch (code) {
+    case 37: event.key.keysym.sym = SDLK_LEFT; break;
+    case 39: event.key.keysym.sym = SDLK_RIGHT; break;
+    case 32: event.key.keysym.sym = SDLK_SPACE; break;
+    case 113: event.key.keysym.sym = SDLK_F2; break;
+    case 114: event.key.keysym.sym = SDLK_F3; break;
+    default: return;
+    }
+    winmain::event_handler(&event);
+}
+#endif
