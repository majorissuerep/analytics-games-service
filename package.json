{
  "name": "analytics-games-service",
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "private": true,
  "description": "Shared web engine and catalog for analytics team games",
  "workspaces": [
    "games/*",
    "packages/*",
    "plugins/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck && npm run workspace:check && npm run build",
    "workspace:check": "turbo run check",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "scan:security": "bash scripts/security-scan.sh",
    "chess-models:admin": "node scripts/chess-model-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "chess.js": "^1.4.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "xp.css": "^0.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.3"
  }
}
